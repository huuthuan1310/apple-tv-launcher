<?xml version="1.0" encoding="utf-8"?>
<!-- Apple TV Liquid Glass Panel: Liquid frosted gradient with specular top border -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#40FFFFFF"
        android:centerColor="#701C1E26"
        android:endColor="#900E1014" />
    <stroke android:width="1dp" android:color="#35FFFFFF" />
    <corners android:radius="@dimen/tvos_panel_radius" />
</shape>
