<?xml version="1.0" encoding="utf-8"?>
<!-- tvOS focus for buttons and list rows: clean zoom without any shadow/elevation -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="1.045" android:duration="200" android:interpolator="@interpolator/tvos_spring" android:valueType="floatType" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="1.045" android:duration="200" android:interpolator="@interpolator/tvos_spring" android:valueType="floatType" />
            <objectAnimator android:propertyName="translationZ" android:valueTo="0dp" android:duration="200" android:valueType="floatType" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="1.0" android:duration="160" android:interpolator="@interpolator/tvos_ease" android:valueType="floatType" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="1.0" android:duration="160" android:interpolator="@interpolator/tvos_ease" android:valueType="floatType" />
            <objectAnimator android:propertyName="translationZ" android:valueTo="0dp" android:duration="160" android:valueType="floatType" />
        </set>
    </item>
</selector>
