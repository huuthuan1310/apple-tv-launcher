<?xml version="1.0" encoding="utf-8"?>
<!-- Apple TV (tvOS) Home Tile: 16:9 rounded rectangle with clean name label below -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingTop="8dp"
    android:paddingBottom="12dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <FrameLayout
        android:id="@+id/card"
        android:layout_width="@dimen/tvos_icon_w"
        android:layout_height="@dimen/tvos_icon_h"
        android:background="@drawable/tile_bg"
        android:outlineProvider="background"
        android:clipToOutline="true"
        android:elevation="0dp"
        android:stateListAnimator="@null"
        android:focusable="true"
        android:clickable="true">

        <!-- 16:9 Banner (YouTube, Plex, etc.) -->
        <ImageView
            android:id="@+id/banner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />

        <!-- Centered square app icon when banner is absent -->
        <ImageView
            android:id="@+id/icon"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_gravity="center"
            android:visibility="gone"
            android:contentDescription="@null" />

        <!-- 3D Specular Sheen Sweep: sweeps across the card 1 time on focus -->
        <com.leotv.launcher.ShineView
            android:id="@+id/shine"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Hidden legacy label inside card: text is rendered cleanly under the card only -->
        <TextView
            android:id="@+id/label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />
    </FrameLayout>

    <!-- App name cleanly positioned below the card (tvOS Caption 1 semibold) -->
    <TextView
        android:id="@+id/name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:singleLine="true"
        android:ellipsize="end"
        android:alpha="0"
        android:textColor="@color/tvos_label_primary"
        android:textSize="@dimen/tvos_text_caption1"
        android:fontFamily="sans-serif-medium"
        android:shadowColor="#80000000"
        android:shadowDy="1"
        android:shadowRadius="4" />
</LinearLayout>
